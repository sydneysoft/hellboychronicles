{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/ua", "destination": "/" },
    { "source": "/ua/novel", "destination": "/novel-uk" }
  ],
  "headers": [
    {
      "source": "/pages/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
