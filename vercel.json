{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/ua", "destination": "/index.html" },
    { "source": "/ua/novel", "destination": "/novel-uk.html" }
  ],
  "headers": [
    {
      "source": "/pages/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
